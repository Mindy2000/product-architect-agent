{
  "name": "product-architect-agent",
  "private": true,
  "version": "0.3.2",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test:frontend": "node --experimental-strip-types --test tests/frontend/*.test.ts",
    "format:check": "prettier --check apps/web/src"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
