# Copy to .env only when ready to configure a model provider.
MODEL_CALLS_ENABLED=false
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_BUDGET_CNY=99


# 阿里云百炼 · 千问视觉理解（默认关闭，仅显式授权调用）
# 仅填写 VISION_API_KEY，不要覆盖上面的 DeepSeek / Dify Key。
# 默认北京地域；Key与接口地域须一致。
# 付费/免费策略需明确选择，不能凭Key判断是否有免费额度。
# 视觉默认关闭；启用前确认模型地域、账户计费、次数与费用保护，不自动重试或切换模型。
VISION_PROVIDER=aliyun
VISION_MODEL=qwen3.8-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_CALLS_ENABLED=false
VISION_FREE_ONLY=true

# Paid vision requires explicit authorization. Never enable automatically.
VISION_MAX_CALLS_TOTAL=1
VISION_BUDGET_CNY=0.02

# Dify Cloud（可选；填写Key不自动启用检索或上传）
RAG_API_KEY=
RAG_API_BASE_URL=https://api.dify.ai/v1

# Docker context：macOS默认colima，Windows默认default。仅需要时设置。
# PA_DOCKER_CONTEXT=desktop-linux

# 千问文字：北京 qwen3.8-flash；复用视觉Key须显式开启，许可独立。
# 同时受 MODEL_CALLS_ENABLED 与既有累计/单任务预算限制；不自动重试/切换。
QWEN_TEXT_API_KEY=
QWEN_TEXT_USE_VISION_KEY=false
QWEN_TEXT_CALLS_ENABLED=false
QWEN_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
